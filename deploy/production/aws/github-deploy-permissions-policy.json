{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuthenticateToEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushExactProductionRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:ap-southeast-1:178868337284:repository/fluenta-production-api",
        "arn:aws:ecr:ap-southeast-1:178868337284:repository/fluenta-production-migrations",
        "arn:aws:ecr:ap-southeast-1:178868337284:repository/fluenta-production-web"
      ]
    },
    {
      "Sid": "RunExactReleaseDocumentOnExactInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-southeast-1:178868337284:document/FluentA-DeployBackendRelease",
        "arn:aws:ec2:ap-southeast-1:178868337284:instance/i-058f1404876ce5edb"
      ]
    },
    {
      "Sid": "ReadCommandResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
