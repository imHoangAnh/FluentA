{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuthenticateToEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullAndResolveExactProductionRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:DescribeImages",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:ap-southeast-1:178868337284:repository/fluenta-production-api",
        "arn:aws:ecr:ap-southeast-1:178868337284:repository/fluenta-production-migrations",
        "arn:aws:ecr:ap-southeast-1:178868337284:repository/fluenta-production-web"
      ]
    }
  ]
}
