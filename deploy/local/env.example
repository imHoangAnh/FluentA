# Copy to deploy/local/.env or run start.ps1 to generate this file.
# Never commit deploy/local/.env.

POSTGRES_DB=fluenta_docker_local
POSTGRES_USER=fluenta_local
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

MINIO_ROOT_USER=fluenta_minio_local
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=fluenta-assets-local
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001

FLUENTA_HTTPS_PORT=7443
JWT_KEY=
OTP_HASH_KEY=

# Required by Google Identity Services in both the frontend and API.
GOOGLE_CLIENT_ID=

# Required for real registration OTP and password-reset delivery.
RESEND_API_KEY=
RESEND_FROM=

# Required for local pronunciation assessment.
AZURE_SPEECH_REGION=
AZURE_SPEECH_SUBSCRIPTION_KEY=
