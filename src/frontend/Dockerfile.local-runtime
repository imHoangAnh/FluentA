# Local build reads the existing .env without copying it into an image layer.
FROM node:22.22.1-alpine3.23@sha256:8094c002d08262dba12645a3b4a15cd6cd627d30bc782f53229a2ec13ee22a00 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG FRONTEND_ENV_SHA
RUN --mount=type=secret,id=frontend_env,target=/app/.env,required=true test -n "$FRONTEND_ENV_SHA" && npm run build

FROM caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
COPY --from=build /app/dist /srv
COPY Caddyfile.docker-local /etc/caddy/Caddyfile
EXPOSE 5173
